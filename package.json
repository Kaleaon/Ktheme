{
  "name": "@ktheme/engine",
  "version": "1.0.0",
  "description": "Advanced theming and design API - An open-source theme engine for creating and managing application themes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ktheme": "./bin/ktheme.mjs"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "scripts": {
    "build": "node packages/tokens/scripts/build-tokens.mjs && tsc && tsc -p packages/react/tsconfig.json",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src packages --ext .ts,.tsx",
    "creator": "cd theme-creator && npm start",
    "release:bump-preset-updated-at": "node scripts/release/bump-preset-updated-at.mjs",
    "generate:theme-catalog": "node scripts/generate-theme-catalog.mjs",
    "check:theme-catalog": "node scripts/generate-theme-catalog.mjs --check",
    "sync-schemas": "npx ts-node scripts/sync-schemas.ts",
    "validate": "node tools/ci-runner.mjs",
    "test:a11y": "node tools/ci-runner.mjs --a11y",
    "test:visual": "node tools/ci-runner.mjs --visual"
  },
  "keywords": [
    "theme",
    "theming",
    "design",
    "ui",
    "colors",
    "styles",
    "metallic",
    "effects"
  ],
  "author": "Kaleaon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaleaon/Ktheme.git"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.5.2",
    "lucide-react": "^0.575.0",
    "playwright": "^1.63.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
